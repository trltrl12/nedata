# Anthropic API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: Override the default model
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Override cache directory (default: ./pdf_cache)
# PDF_CACHE_DIR=./pdf_cache

# Optional: Max pages to send per PDF (default: 15)
# MAX_PAGES=15

# Optional: Max retry attempts for failed extractions (default: 3)
# MAX_RETRIES=3
